{
  "widgets": [
    {
      "category": "Demo",
      "configuration": {
        "properties": [
          {
            "name": "cards_per_row",
            "type": "number",
            "label": "Cards Per Row",
            "defaultValue": 3,
            "rules": {
              "required": true,
              "minimum": 1,
              "maximum": 6
            }
          },
          {
            "name": "card_background",
            "type": "color",
            "label": "Card Background",
            "defaultValue": "#ffffff"
          },
          {
            "name": "card_text_color",
            "type": "color",
            "label": "Text Color",
            "defaultValue": "#1f2937"
          },
          {
            "name": "accent_color",
            "type": "color",
            "label": "Accent Color",
            "defaultValue": "#3b82f6"
          },
          {
            "name": "title_size",
            "type": "select",
            "label": "Title Size",
            "defaultValue": "medium",
            "options": [
              {
                "value": "small",
                "label": "Small"
              },
              {
                "value": "medium",
                "label": "Medium"
              },
              {
                "value": "large",
                "label": "Large"
              }
            ]
          },
          {
            "name": "card_style",
            "type": "select",
            "label": "Card Style",
            "defaultValue": "shadow",
            "options": [
              {
                "value": "flat",
                "label": "Flat"
              },
              {
                "value": "shadow",
                "label": "Shadow"
              },
              {
                "value": "bordered",
                "label": "Bordered"
              }
            ]
          },
          {
            "name": "show_icons",
            "type": "select",
            "label": "Show Icons",
            "defaultValue": "yes",
            "options": [
              {
                "value": "yes",
                "label": "Yes"
              },
              {
                "value": "no",
                "label": "No"
              }
            ]
          }
        ]
      },
      "containers": [
        "Full width"
      ],
      "defaultConfig": {
        "cards_per_row": 3,
        "card_background": "#ffffff",
        "card_text_color": "#1f2937",
        "accent_color": "#3b82f6",
        "title_size": "medium",
        "card_style": "shadow",
        "show_icons": "yes"
      },
      "description": "A configurable card grid widget demonstrating dynamic layout and styling options",
      "settings": {
        "configurable": true,
        "editable": true,
        "removable": true,
        "shared": false,
        "movable": false
      },
      "title": "Card Grid",
      "version": "1.0.0",
      "widgetsLibrary": true,
      "type": "card_grid",
      "source": {
        "path": "widgets/card_grid/dist",
        "entry": "content.html"
      },
      "imageSrc": "widgets/card_grid/thumbnail.png"
    },
    {
      "category": "Demo",
      "containers": [
        "Full width"
      ],
      "description": "Demo widget for presentation purposes",
      "settings": {
        "configurable": true,
        "editable": true,
        "removable": true,
        "shared": false,
        "movable": false
      },
      "title": "Demo widget",
      "version": "1.0.0",
      "widgetsLibrary": true,
      "type": "demo_widget",
      "source": {
        "path": "widgets/demo_widget/dist",
        "entry": "content.html"
      },
      "imageSrc": "widgets/demo_widget/thumbnail.png"
    },
    {
      "category": "Feedback",
      "configuration": {
        "properties": [
          {
            "name": "widget_title",
            "type": "text",
            "label": "Widget Title",
            "defaultValue": "Product Ideas",
            "rules": {
              "required": true,
              "maxLength": 100
            }
          },
          {
            "name": "view_filter",
            "type": "select",
            "label": "Default View",
            "defaultValue": "most-wanted",
            "options": [
              {
                "value": "most-wanted",
                "label": "Most Wanted"
              },
              {
                "value": "recent",
                "label": "Recent"
              },
              {
                "value": "trending",
                "label": "Trending"
              },
              {
                "value": "most-discussed",
                "label": "Most Discussed"
              },
              {
                "value": "planned",
                "label": "Planned"
              },
              {
                "value": "started",
                "label": "In Progress"
              },
              {
                "value": "completed",
                "label": "Completed"
              },
              {
                "value": "all",
                "label": "All"
              }
            ]
          },
          {
            "name": "max_ideas",
            "type": "number",
            "label": "Max Ideas to Show",
            "defaultValue": 10,
            "rules": {
              "required": true,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "accent_color",
            "type": "color",
            "label": "Accent Color",
            "defaultValue": "#6366f1"
          }
        ]
      },
      "containers": [
        "Full width"
      ],
      "defaultConfig": {
        "widget_title": "Product Ideas",
        "view_filter": "most-wanted",
        "max_ideas": 10,
        "accent_color": "#6366f1"
      },
      "description": "Source and submit product ideas from your Fider feedback portal",
      "settings": {
        "configurable": true,
        "editable": true,
        "removable": true,
        "shared": false,
        "movable": false
      },
      "title": "Product Ideas",
      "version": "1.0.0",
      "widgetsLibrary": true,
      "type": "fider_ideas",
      "source": {
        "path": "widgets/fider_ideas/dist",
        "entry": "content.html"
      }
    },
    {
      "category": "Demo",
      "configuration": {
        "properties": [
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "defaultValue": "React Widget",
            "rules": {
              "required": true
            }
          },
          {
            "name": "description",
            "type": "text",
            "label": "Description",
            "defaultValue": "A widget built with React and the Widget SDK."
          }
        ]
      },
      "containers": [
        "Full width"
      ],
      "defaultConfig": {
        "title": "React Widget",
        "description": "A widget built with React and the Widget SDK."
      },
      "description": "A React widget using the ESM module pattern with Widget SDK",
      "settings": {
        "configurable": true,
        "editable": true,
        "removable": true,
        "shared": false,
        "movable": false
      },
      "title": "React Widget",
      "version": "1.0.0",
      "widgetsLibrary": true,
      "type": "react_widget",
      "source": {
        "path": "widgets/react_widget/dist",
        "entry": "index.html"
      },
      "imageSrc": "widgets/react_widget/thumbnail.png"
    },
    {
      "category": "Test",
      "configuration": {
        "properties": [
          {
            "name": "greeting",
            "type": "text",
            "label": "Greeting text",
            "description": "Main heading displayed in the widget",
            "defaultValue": "Smoke Test",
            "rules": {
              "required": true,
              "maxLength": 80
            }
          },
          {
            "name": "accent_color",
            "type": "color",
            "label": "Accent color",
            "description": "Color used for the heading underline",
            "defaultValue": "#3b82f6"
          }
        ]
      },
      "containers": [
        "Full width"
      ],
      "defaultConfig": {
        "greeting": "Smoke Test",
        "accent_color": "#3b82f6"
      },
      "description": "Verifies the extension pipeline works end-to-end: widget rendering, config, and connector calls",
      "settings": {
        "configurable": true,
        "editable": true,
        "removable": true,
        "shared": false,
        "movable": false
      },
      "title": "Smoke Test",
      "version": "1.0.0",
      "widgetsLibrary": true,
      "type": "smoke_test",
      "source": {
        "path": "widgets/smoke_test/dist",
        "entry": "content.html"
      }
    }
  ],
  "stylesheets": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "name": "hello_styles",
      "description": "Test stylesheet with a utility class for highlighted text",
      "path": "./stylesheets/hello_styles/style.css"
    },
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "name": "theme",
      "description": "Shared design tokens and component styles",
      "path": "./stylesheets/theme/style.css"
    }
  ],
  "scripts": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "placement": "head",
      "name": "analytics",
      "description": "Tracks widget impressions and interactions",
      "path": "./scripts/analytics/script.js"
    },
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "placement": "head",
      "name": "hello_logger",
      "description": "Test script that logs page load timing to the console",
      "path": "./scripts/hello_logger/script.js"
    }
  ]
}
