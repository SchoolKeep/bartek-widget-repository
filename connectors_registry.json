{
  "connectors": [
    {
      "name": "REST Countries",
      "url": "https://restcountries.com/v3.1/all",
      "method": "GET",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "fields",
          "value": "name,capital,population,flags,region",
          "overridable": false
        }
      ],
      "permalink": "rest-countries"
    },
    {
      "name": "Weather Forecast",
      "url": "https://api.open-meteo.com/v1/forecast",
      "method": "GET",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "latitude",
          "value": "52.52",
          "overridable": true
        },
        {
          "key": "longitude",
          "value": "13.41",
          "overridable": true
        },
        {
          "key": "daily",
          "value": "temperature_2m_max,temperature_2m_min,weathercode",
          "overridable": false
        },
        {
          "key": "timezone",
          "value": "auto",
          "overridable": false
        },
        {
          "key": "forecast_days",
          "value": "7",
          "overridable": true
        }
      ],
      "permalink": "weather-forecast"
    },
    {
      "name": "Fider List Posts",
      "url": "https://bartek-gainsight.fider.io/api/v1/posts",
      "method": "GET",
      "headers": [
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "query_parameters": [
        {
          "key": "view",
          "value": "most-wanted",
          "overridable": true
        },
        {
          "key": "limit",
          "value": "10",
          "overridable": true
        }
      ],
      "authentication": {
        "type": "apikey",
        "config": {
          "key": "Authorization",
          "value": "Bearer {{ get_secret('fider_api_key') }}",
          "in": "header"
        }
      },
      "permalink": "fider-list-posts"
    },
    {
      "name": "Fider Create Post",
      "url": "https://bartek-gainsight.fider.io/api/v1/posts",
      "method": "POST",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json",
          "overridable": false
        },
        {
          "key": "Accept",
          "value": "application/json",
          "overridable": false
        }
      ],
      "request_body": "{{ body_text }}",
      "authentication": {
        "type": "apikey",
        "config": {
          "key": "Authorization",
          "value": "Bearer {{ get_secret('fider_api_key') }}",
          "in": "header"
        }
      },
      "permalink": "fider-create-post"
    }
  ]
}
