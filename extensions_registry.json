{
  "widgets": [
    {
      "version": "1.0.0",
      "title": "Bartek Test",
      "description": "A simple test widget in the Bartek category",
      "category": "Bartek",
      "source": {
        "path": "widgets/bartek_test/dist",
        "entry": "content.html"
      },
      "configuration": {
        "properties": [
          {
            "name": "heading",
            "type": "text",
            "label": "Heading",
            "description": "Main heading displayed in the widget",
            "defaultValue": "Hello from Bartek!",
            "rules": {
              "required": true,
              "maxLength": 100
            }
          },
          {
            "name": "accent_color",
            "type": "color",
            "label": "Accent Color",
            "description": "Color used for decorative elements",
            "defaultValue": "#6366f1"
          }
        ]
      },
      "defaultConfig": {
        "heading": "Hello from Bartek!",
        "accent_color": "#6366f1"
      },
      "type": "bartek_test"
    },
    {
      "version": "1.0.0",
      "title": "Emoji Probe 🎉",
      "description": "Probes whether emoji and unicode survive the publish pipeline in every user-facing text field 🚀",
      "category": "Test",
      "source": {
        "path": "widgets/emoji_probe/dist",
        "entry": "content.html"
      },
      "configuration": {
        "properties": [
          {
            "name": "greeting",
            "type": "text",
            "label": "Greeting 👋",
            "description": "Rendered at the top of the widget — should accept emoji",
            "defaultValue": "Hello, world! 🌎",
            "rules": {
              "required": true,
              "maxLength": 80
            }
          },
          {
            "name": "icon",
            "type": "text",
            "label": "Icon",
            "description": "Single-emoji default",
            "defaultValue": "🚀"
          },
          {
            "name": "zalgo",
            "type": "text",
            "label": "Unicode stress",
            "description": "Combining marks and non-BMP chars",
            "defaultValue": "H̷e̴l̸l̶o̵ 𝕌𝕟𝕚𝕔𝕠𝕕𝕖"
          },
          {
            "name": "accent_color",
            "type": "color",
            "label": "Accent color",
            "defaultValue": "#6366f1"
          }
        ]
      },
      "defaultConfig": {
        "greeting": "Hello, world! 🌎",
        "icon": "🚀",
        "zalgo": "H̷e̴l̸l̶o̵ 𝕌𝕟𝕚𝕔𝕠𝕕𝕖",
        "accent_color": "#6366f1"
      },
      "type": "emoji_probe"
    },
    {
      "version": "1.0.0",
      "title": "Product Ideas",
      "description": "Source and submit product ideas from your Fider feedback portal",
      "category": "Feedback",
      "configuration": {
        "properties": [
          {
            "name": "widget_title",
            "type": "text",
            "label": "Widget Title",
            "defaultValue": "Product Ideas",
            "rules": {
              "required": true,
              "maxLength": 100
            }
          },
          {
            "name": "view_filter",
            "type": "select",
            "label": "Default View",
            "defaultValue": "most-wanted",
            "options": [
              {
                "value": "most-wanted",
                "label": "Most Wanted"
              },
              {
                "value": "recent",
                "label": "Recent"
              },
              {
                "value": "trending",
                "label": "Trending"
              },
              {
                "value": "most-discussed",
                "label": "Most Discussed"
              },
              {
                "value": "planned",
                "label": "Planned"
              },
              {
                "value": "started",
                "label": "In Progress"
              },
              {
                "value": "completed",
                "label": "Completed"
              },
              {
                "value": "all",
                "label": "All"
              }
            ]
          },
          {
            "name": "max_ideas",
            "type": "number",
            "label": "Max Ideas to Show",
            "defaultValue": 10,
            "rules": {
              "required": true,
              "minimum": 1,
              "maximum": 100
            }
          },
          {
            "name": "accent_color",
            "type": "color",
            "label": "Accent Color",
            "defaultValue": "#6366f1"
          }
        ]
      },
      "defaultConfig": {
        "widget_title": "Product Ideas",
        "view_filter": "most-wanted",
        "max_ideas": 10,
        "accent_color": "#6366f1"
      },
      "source": {
        "path": "widgets/fider_ideas/dist",
        "entry": "content.html"
      },
      "type": "fider_ideas"
    },
    {
      "version": "2.1.3",
      "title": "Smoke Test",
      "description": "Tile-based countdown to a configurable target moment — no connectors, no SDK fetches, pure client-side rendering",
      "category": "Test",
      "source": {
        "path": "widgets/midnight_countdown/dist",
        "entry": "index.html"
      },
      "configuration": {
        "properties": [
          {
            "name": "target_iso",
            "type": "text",
            "label": "Target timestamp (ISO 8601)",
            "description": "When the countdown should reach zero",
            "defaultValue": "2026-12-31T23:59:59Z",
            "rules": {
              "required": true,
              "maxLength": 40
            }
          },
          {
            "name": "tile_count",
            "type": "number",
            "label": "Number of tiles",
            "description": "How many animated flip tiles to render",
            "defaultValue": 4,
            "rules": {
              "required": true,
              "minimum": 1,
              "maximum": 12
            }
          },
          {
            "name": "show_seconds",
            "type": "boolean",
            "label": "Show seconds",
            "defaultValue": true
          },
          {
            "name": "tile_background",
            "type": "color",
            "label": "Tile background",
            "defaultValue": "#0f172a"
          }
        ]
      },
      "defaultConfig": {
        "target_iso": "2026-12-31T23:59:59Z",
        "tile_count": 4,
        "show_seconds": true,
        "tile_background": "#0f172a"
      },
      "type": "midnight_countdown"
    },
    {
      "version": "1.0.0",
      "title": "React Widget",
      "description": "A React widget using the ESM module pattern with Widget SDK",
      "category": "Demo",
      "imageSrc": "widgets/react_widget/thumbnail.png",
      "source": {
        "path": "widgets/react_widget/dist",
        "entry": "index.html"
      },
      "configuration": {
        "properties": [
          {
            "name": "title",
            "type": "text",
            "label": "Title",
            "defaultValue": "React Widget",
            "rules": {
              "required": true
            }
          },
          {
            "name": "description",
            "type": "text",
            "label": "Description",
            "defaultValue": "A widget built with React and the Widget SDK."
          }
        ]
      },
      "defaultConfig": {
        "title": "React Widget",
        "description": "A widget built with React and the Widget SDK."
      },
      "type": "react_widget"
    },
    {
      "version": "1.0.0",
      "title": "Smoke Test",
      "description": "Verifies the extension pipeline works end-to-end: widget rendering, config, and connector calls",
      "category": "Test",
      "source": {
        "path": "widgets/smoke_test/dist",
        "entry": "content.html"
      },
      "configuration": {
        "properties": [
          {
            "name": "greeting",
            "type": "text",
            "label": "Greeting text",
            "description": "Main heading displayed in the widget",
            "defaultValue": "Smoke Test",
            "rules": {
              "required": true,
              "maxLength": 80
            }
          },
          {
            "name": "accent_color",
            "type": "color",
            "label": "Accent color",
            "description": "Color used for the heading underline",
            "defaultValue": "#3b82f6"
          }
        ]
      },
      "defaultConfig": {
        "greeting": "Smoke Test",
        "accent_color": "#3b82f6"
      },
      "type": "smoke_test"
    }
  ],
  "stylesheets": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "name": "hello_styles",
      "description": "Test stylesheet with a utility class for highlighted text",
      "path": "./stylesheets/hello_styles/style.css"
    },
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "name": "theme",
      "description": "Shared design tokens and component styles",
      "path": "./stylesheets/theme/style.css"
    }
  ],
  "scripts": [
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "placement": "head",
      "name": "analytics",
      "description": "Tracks widget impressions and interactions",
      "path": "./scripts/analytics/script.js"
    },
    {
      "rules": [
        {
          "field": "pageType",
          "operator": "in",
          "value": [
            "global"
          ]
        }
      ],
      "placement": "head",
      "name": "hello_logger",
      "description": "Test script that logs page load timing to the console",
      "path": "./scripts/hello_logger/script.js"
    }
  ]
}
